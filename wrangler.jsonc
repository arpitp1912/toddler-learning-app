// Cloudflare Workers config. The app is static: Workers serves the Vite build in dist/.
// `previews` lets non-main branches get a preview link (Workers Builds runs `wrangler preview`).
{
  "name": "toddler-learning-app",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./dist" },
  "previews": {}
}
